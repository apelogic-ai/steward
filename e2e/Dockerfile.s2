FROM rust:1.95-bookworm@sha256:6258907abe69656e41cd992e0b705cdcfabcbbe3db374f92ed2d47121282d4a1 AS build

WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY adapters ./adapters
COPY bins ./bins
COPY crates ./crates
COPY migrations ./migrations
COPY xtask ./xtask
RUN cargo build --locked -p steward-controller-bin --release

FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818

COPY --from=build /src/target/release/steward-controller-bin /usr/local/bin/steward-controller
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/steward-controller"]
