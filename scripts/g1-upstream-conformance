#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TARGET="${STEWARD_CONFORMANCE_TARGET:-}"
G1_BASE_IMAGE="ghcr.io/nvidia/openshell-community/sandboxes/base@sha256:aeef1c63f00e2913ea002ccb3aaf925f338b5c5d70e63576f0d95c16a138044e"

case "${TARGET}" in
  pinned)
    release="v0.1.2"
    ;;
  latest)
    release="$(
      curl -fsSL https://api.github.com/repos/NVIDIA/OpenShell/releases/latest |
        jq -er '.tag_name | select(test("^v[0-9]+\\.[0-9]+\\.[0-9]+$"))'
    )"
    ;;
  *)
    echo "STEWARD_CONFORMANCE_TARGET must be pinned or latest" >&2
    exit 2
    ;;
esac

run_id="g1-$(date -u +%Y%m%d%H%M%S)-$$"
STEWARD_RUN_ID="${run_id}" \
STEWARD_OPEN_SHELL_RELEASE="${release}" \
STEWARD_OPENSHELL_PRELOAD_IMAGE="${G1_BASE_IMAGE}" \
STEWARD_G1_BASE_IMAGE="${G1_BASE_IMAGE}" \
bash "${ROOT}/scripts/openshell-testbed.sh" \
  bash "${ROOT}/scripts/g1-upstream-conformance-inside.sh"
