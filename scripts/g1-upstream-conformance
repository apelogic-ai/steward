#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TARGET="${STEWARD_CONFORMANCE_TARGET:-}"

case "${TARGET}" in
  pinned)
    release="v0.0.90"
    use_chart_supervisor=0
    ;;
  latest)
    release="$(
      curl -fsSL https://api.github.com/repos/NVIDIA/OpenShell/releases/latest |
        jq -er '.tag_name | select(test("^v[0-9]+\\.[0-9]+\\.[0-9]+$"))'
    )"
    use_chart_supervisor=1
    ;;
  *)
    echo "STEWARD_CONFORMANCE_TARGET must be pinned or latest" >&2
    exit 2
    ;;
esac

STEWARD_OPEN_SHELL_RELEASE="${release}" \
STEWARD_RUN_ID="g1-$(date -u +%Y%m%d%H%M%S)-$$" \
STEWARD_USE_CHART_SUPERVISOR="${use_chart_supervisor}" \
  bash "${ROOT}/scripts/s0-0-openshell-spike.sh" \
  bash "${ROOT}/scripts/g1-upstream-conformance-inside.sh"

echo "G-1 upstream result: 1 passed; 0 failed; 0 skipped"
echo "G-1 ${TARGET} upstream evidence passed against OpenShell ${release}"
