{
  "schemaVersion": "steward/catalog/local-skill/v1",
  "name": "inspect-repository",
  "kind": "instruction_only",
  "instructions": "instructions.test",
  "assets": [
    "references/checklist.test"
  ],
  "requires": {
    "execution": {
      "schemaVersion": "steward/catalog/execution-requirements/v1",
      "capabilities": [
        "shell"
      ]
    },
    "authority": {
      "schemaVersion": "steward/catalog/authority-requirements/v1",
      "models": [
        {
          "provider": "litellm",
          "model": "review-model"
        }
      ],
      "tools": [],
      "budget": {
        "currency": "USD",
        "maxTaskAmount": "2.00",
        "maxMonthlyAmount": "50.00"
      },
      "ttlSeconds": 3600,
      "runnerResources": {
        "cpuMillis": 1000,
        "memoryMiB": 2048,
        "ephemeralStorageMiB": 4096
      }
    }
  }
}
