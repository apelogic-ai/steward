{
  "schemaVersion": "steward/catalog/task-definition/v1",
  "name": "repository-review",
  "version": 1,
  "agent": "coding-agent@1",
  "prompt": "prompt.test",
  "skills": [
    "skills/inspect-repository/skill.test"
  ],
  "lock": "dependencies.test",
  "requires": {
    "execution": {
      "schemaVersion": "steward/catalog/execution-requirements/v1",
      "capabilities": [
        "shell"
      ]
    },
    "authority": {
      "schemaVersion": "steward/catalog/authority-requirements/v1",
      "models": [
        {
          "provider": "litellm",
          "model": "review-model"
        }
      ],
      "tools": [],
      "budget": {
        "currency": "USD",
        "maxTaskAmount": "2.00",
        "maxMonthlyAmount": "50.00"
      },
      "ttlSeconds": 3600,
      "runnerResources": {
        "cpuMillis": 1000,
        "memoryMiB": 2048,
        "ephemeralStorageMiB": 4096
      }
    }
  }
}
