{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["components", "steward", "spire", "agentSandbox", "openshell", "litellm", "arc"],
  "properties": {
    "global": {"type": "object", "maxProperties": 0, "additionalProperties": false},
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steward", "spire", "agentSandbox", "openshell", "litellm", "arc"],
      "properties": {
        "steward": {"$ref": "#/definitions/component"},
        "spire": {"$ref": "#/definitions/component"},
        "agentSandbox": {"$ref": "#/definitions/component"},
        "openshell": {"$ref": "#/definitions/component"},
        "litellm": {"$ref": "#/definitions/component"},
        "arc": {"$ref": "#/definitions/component"}
      }
    },
    "steward": {"$ref": "#/definitions/childWithoutGlobals"},
    "spire": {"type": "object"},
    "agentSandbox": {"$ref": "#/definitions/childWithoutGlobals"},
    "openshell": {"$ref": "#/definitions/childWithoutGlobals"},
    "litellm": {"$ref": "#/definitions/childWithoutGlobals"},
    "arc": {"$ref": "#/definitions/childWithoutGlobals"}
  },
  "definitions": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    },
    "childWithoutGlobals": {
      "type": "object",
      "properties": {
        "global": {"type": "object", "maxProperties": 0, "additionalProperties": false}
      }
    }
  }
}
