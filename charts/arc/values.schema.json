{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["arc"],
  "properties": {
    "global": {"type": "object"},
    "arc": {
      "type": "object",
      "additionalProperties": true,
      "required": ["image", "namespaceOverride"],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": true,
          "required": ["repository", "tag"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string", "pattern": "^[^@[:space:]]+@sha256:[0-9a-f]{64}$"}
          }
        },
        "namespaceOverride": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"}
      }
    }
  }
}
