{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "images",
    "web",
    "secrets",
    "browserAuth",
    "workloadExchangeTrust",
    "taskIdentity",
    "tls",
    "config",
    "connectionsBridge",
    "runtimeNamespaces",
    "networkPolicy",
    "spire",
    "services",
    "replicaCount",
    "resources"
  ],
  "properties": {
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pullPolicy", "apiserver", "controller", "mint", "web"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "pullPolicy": {"enum": ["IfNotPresent", "Always", "Never"]},
        "apiserver": {"$ref": "#/definitions/image"},
        "controller": {"$ref": "#/definitions/image"},
        "mint": {"$ref": "#/definitions/image"},
        "web": {"$ref": "#/definitions/optionalImage"}
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "host", "ingress"],
      "properties": {
        "enabled": {"type": "boolean"},
        "host": {"type": "string"},
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "className", "tlsSecretName"],
          "properties": {
            "enabled": {"type": "boolean"},
            "className": {"type": "string"},
            "tlsSecretName": {"type": "string"}
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database", "jira", "litellm", "openshellClient", "mint"],
      "properties": {
        "database": {"$ref": "#/definitions/secretKey"},
        "jira": {"$ref": "#/definitions/secretKey"},
        "litellm": {"$ref": "#/definitions/secretKey"},
        "openshellClient": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "caCertificate",
            "clientCertificate",
            "clientPrivateKey"
          ],
          "properties": {
            "name": {"$ref": "#/definitions/nonempty"},
            "caCertificate": {"$ref": "#/definitions/nonempty"},
            "clientCertificate": {"$ref": "#/definitions/nonempty"},
            "clientPrivateKey": {"$ref": "#/definitions/nonempty"}
          }
        },
        "mint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "signingKey", "introspectionCredential"],
          "properties": {
            "name": {"$ref": "#/definitions/nonempty"},
            "signingKey": {"$ref": "#/definitions/nonempty"},
            "introspectionCredential": {"$ref": "#/definitions/nonempty"}
          }
        }
      }
    },
    "browserAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "google"],
      "properties": {
        "enabled": {"type": "boolean"},
        "google": {
          "type": "object",
          "additionalProperties": false,
          "required": ["clientId", "origin", "workspaceDomain", "organizationId", "clientSecret"],
          "properties": {
            "clientId": {"type": "string"},
            "origin": {"type": "string"},
            "workspaceDomain": {"type": "string"},
            "organizationId": {"type": "string"},
            "clientSecret": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "key"],
              "properties": {
                "name": {"type": "string"},
                "key": {"type": "string"}
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "enabled": {"const": false},
            "google": {
              "properties": {
                "clientId": {"const": ""},
                "origin": {"const": ""},
                "workspaceDomain": {"const": ""},
                "organizationId": {"const": ""},
                "clientSecret": {
                  "properties": {
                    "name": {"const": ""},
                    "key": {"const": ""}
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "enabled": {"const": true},
            "google": {
              "properties": {
                "clientId": {"type": "string", "minLength": 1, "pattern": "^\\S+$"},
                "origin": {"type": "string", "minLength": 9, "pattern": "^https://[^\\s/@?#:]+(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?$"},
                "workspaceDomain": {"type": "string", "minLength": 3, "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$"},
                "organizationId": {"type": "string", "minLength": 1, "pattern": "^\\S+$"},
                "clientSecret": {
                  "properties": {
                    "name": {"$ref": "#/definitions/nonempty"},
                    "key": {"$ref": "#/definitions/nonempty"}
                  }
                }
              }
            }
          }
        }
      ]
    },
    "workloadExchangeTrust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "caCertificate"],
      "properties": {
        "kind": {"type": "string", "enum": ["ConfigMap", "Secret"]},
        "name": {"$ref": "#/definitions/nonempty"},
        "caCertificate": {"$ref": "#/definitions/nonempty"}
      }
    },
    "taskIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "issuer", "audience", "publicJwksConfigMap"],
      "properties": {
        "enabled": {"type": "boolean"},
        "issuer": {"type": "string"},
        "audience": {"type": "string"},
        "publicJwksConfigMap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "key"],
          "properties": {"name": {"type": "string"}, "key": {"type": "string"}}
        }
      },
      "oneOf": [
        {
          "properties": {
            "enabled": {"const": false},
            "issuer": {"const": ""},
            "audience": {"const": ""},
            "publicJwksConfigMap": {
              "properties": {"name": {"const": ""}, "key": {"const": ""}}
            }
          }
        },
        {
          "properties": {
            "enabled": {"const": true},
            "issuer": {"type": "string", "pattern": "^https://[^/?#]+(?:/[^?#]*)?$"},
            "audience": {"$ref": "#/definitions/nonempty"},
            "publicJwksConfigMap": {
              "properties": {"name": {"$ref": "#/definitions/nonempty"}, "key": {"$ref": "#/definitions/nonempty"}}
            }
          }
        }
      ]
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuerRef"],
      "properties": {
        "issuerRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "kind"],
          "properties": {
            "name": {"$ref": "#/definitions/nonempty"},
            "kind": {"enum": ["Issuer", "ClusterIssuer"]},
            "group": {"type": "string", "default": "cert-manager.io"}
          }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiserver", "controller", "mint"],
      "properties": {
        "apiserver": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "jiraBaseUrl",
            "jiraProjectKey",
            "jiraAccountEmail",
            "kubernetesTokenReviewAudience",
            "taskWorkflowsJson",
            "executionBindingsMode",
            "executionBindings",
            "mcpGatewayEndpoint"
          ],
          "properties": {
            "jiraBaseUrl": {"type": "string", "pattern": "^https://", "minLength": 9},
            "jiraProjectKey": {"$ref": "#/definitions/nonempty"},
            "jiraAccountEmail": {"type": "string", "minLength": 3},
            "kubernetesTokenReviewAudience": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "taskWorkflowsJson": {"type": "string", "pattern": "^\\s*\\[", "minLength": 2},
            "executionBindingsMode": {"type": "string", "enum": ["staged", "active"]},
            "executionBindings": {
              "type": "object",
              "additionalProperties": false,
              "required": ["apiVersion", "bindings"],
              "properties": {
                "apiVersion": {"const": "steward.execution-bindings/v1"},
                "bindings": {
                  "type": "array",
                  "maxItems": 128,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "agentRef",
                      "adapter",
                      "image",
                      "executable",
                      "versionProbe",
                      "providerProfiles"
                    ],
                    "properties": {
                      "agentRef": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 255,
                        "pattern": "^[a-z0-9][a-z0-9._/-]*@[0-9][a-z0-9._+-]*$"
                      },
                      "displayName": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^[^\\s\\x00-\\x1F\\x7F](?:[^\\x00-\\x1F\\x7F]*[^\\s\\x00-\\x1F\\x7F])?$"
                      },
                      "adapter": {"const": "codex-v1"},
                      "image": {
                        "type": "string",
                        "maxLength": 327,
                        "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*@sha256:[a-f0-9]{64}$"
                      },
                      "executable": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 1024,
                        "pattern": "^/(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+$"
                      },
                      "versionProbe": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["arguments", "expectedStdout"],
                        "properties": {
                          "arguments": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 8,
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128,
                              "pattern": "^[^\\x00-\\x1F\\x7F]+$"
                            }
                          },
                          "expectedStdout": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 255,
                            "pattern": "^[^\\s\\x00-\\x1F\\x7F](?:[^\\x00-\\x1F\\x7F]*[^\\s\\x00-\\x1F\\x7F])?$"
                          }
                        }
                      },
                      "providerProfiles": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "tools": {"$ref": "#/definitions/executionProviderProfile"},
                          "inference": {"$ref": "#/definitions/executionProviderProfile"}
                        }
                      }
                    }
                  }
                }
              }
            },
            "mcpGatewayEndpoint": {
              "type": "string",
              "pattern": "^$|^https?://[^\\s/@?#:]+(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:/[^\\s?#]*)?$"
            }
          }
        },
        "controller": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "openshellEndpoint",
            "openshellServerName",
            "openshellRuntimeClassName",
            "openshellTaskLogMode",
            "workloadExchangeEndpoint",
            "workloadExchangeServerName",
            "litellmUrl"
          ],
          "properties": {
            "openshellEndpoint": {"type": "string", "pattern": "^https://", "minLength": 9},
            "openshellServerName": {"$ref": "#/definitions/nonempty"},
            "openshellRuntimeClassName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$"
            },
            "openshellTaskLogMode": {"type": "string", "enum": ["off", "full"]},
            "workloadExchangeEndpoint": {
              "type": "string",
              "pattern": "^https://[^/?#]+(?::[0-9]+)?/v1/workload/exchange$",
              "minLength": 38
            },
            "workloadExchangeServerName": {"$ref": "#/definitions/nonempty"},
            "litellmUrl": {"type": "string", "pattern": "^https?://", "minLength": 9}
          }
        },
        "mint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issuer",
            "audience",
            "allowedScopes",
            "svidAudience",
            "spiffeTrustDomain",
            "openshellNamespace"
          ],
          "properties": {
            "issuer": {"type": "string", "pattern": "^https?://", "minLength": 9},
            "audience": {"$ref": "#/definitions/nonempty"},
            "allowedScopes": {"$ref": "#/definitions/nonempty"},
            "svidAudience": {"$ref": "#/definitions/nonempty"},
            "spiffeTrustDomain": {"$ref": "#/definitions/nonempty"},
            "openshellNamespace": {"$ref": "#/definitions/nonempty"}
          }
        }
      }
    },
    "stableBridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "signerIdentity",
        "sourceRepository",
        "sourceCommit",
        "service",
        "attestationBundle"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"type": "string"},
        "signerIdentity": {"type": "string"},
        "sourceRepository": {"type": "string"},
        "sourceCommit": {"type": "string"},
        "service": {"type": "string"},
        "attestationBundle": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"enabled": {"const": true}}},
          "then": {
            "properties": {
              "image": {
                "type": "string",
                "pattern": "^.+@sha256:[a-f0-9]{64}$"
              },
              "signerIdentity": {"$ref": "#/definitions/nonempty"},
              "sourceRepository": {
                "type": "string",
                "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
              },
              "sourceCommit": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "service": {"$ref": "#/definitions/nonempty"},
              "attestationBundle": {"$ref": "#/definitions/nonempty"}
            }
          }
        }
      ]
    },
    "connectionsBridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "artifactTrust",
        "image",
        "signerIdentity",
        "sourceRepository",
        "sourceCommit",
        "mcpGatewayOrigin",
        "mcpGatewayVersion",
        "runtimeNamespace",
        "attestationBundle"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "artifactTrust": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["github-attestation", "operator-pinned"]
            }
          }
        },
        "image": {"type": "string"},
        "signerIdentity": {"type": "string"},
        "sourceRepository": {"type": "string"},
        "sourceCommit": {"type": "string"},
        "mcpGatewayOrigin": {"type": "string"},
        "mcpGatewayVersion": {"type": "string"},
        "runtimeNamespace": {"type": "string"},
        "attestationBundle": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"enabled": {"const": true}}},
          "then": {
            "properties": {
              "mcpGatewayOrigin": {
                "type": "string",
                "pattern": "^https?://[^\\s/@?#:]+(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?$",
                "minLength": 10
              },
              "mcpGatewayVersion": {"const": "0.3.2"},
              "runtimeNamespace": {"$ref": "#/definitions/nonempty"}
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "artifactTrust": {
                      "properties": {"mode": {"const": "github-attestation"}}
                    }
                  }
                },
                "then": {
                  "properties": {
                    "image": {"type": "string", "pattern": "^.+@sha256:[a-f0-9]{64}$"},
                    "signerIdentity": {"$ref": "#/definitions/nonempty"},
                    "sourceRepository": {
                      "type": "string",
                      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                    },
                    "sourceCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
                    "attestationBundle": {"$ref": "#/definitions/nonempty"}
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "artifactTrust": {
                      "properties": {"mode": {"const": "operator-pinned"}}
                    }
                  }
                },
                "then": {
                  "properties": {
                    "image": {
                      "type": "string",
                      "pattern": "^[a-z0-9._-]+(?::[0-9]+)?(?:/[a-z0-9._-]+)*@sha256:[a-f0-9]{64}$"
                    },
                    "signerIdentity": {"maxLength": 0},
                    "sourceRepository": {"maxLength": 0},
                    "sourceCommit": {"maxLength": 0},
                    "attestationBundle": {"maxLength": 0}
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "runtimeNamespaces": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "dnsNamespace",
        "kubeApiCidrs",
        "postgresCidrs",
        "jiraCidrs",
        "browserAuthEgressCidrs",
        "ingressNamespace",
        "burbleNamespace",
        "arcNamespace",
        "mcpGatewayNamespace",
        "openshellNamespace",
        "identityExchangeNamespace",
        "litellmNamespace",
        "ports"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "dnsNamespace": {"$ref": "#/definitions/nonempty"},
        "kubeApiCidrs": {"$ref": "#/definitions/cidrs"},
        "postgresCidrs": {"$ref": "#/definitions/cidrs"},
        "jiraCidrs": {"$ref": "#/definitions/cidrs"},
        "browserAuthEgressCidrs": {"$ref": "#/definitions/cidrs"},
        "ingressNamespace": {"$ref": "#/definitions/nonempty"},
        "burbleNamespace": {"$ref": "#/definitions/nonempty"},
        "arcNamespace": {"$ref": "#/definitions/nonempty"},
        "mcpGatewayNamespace": {"$ref": "#/definitions/nonempty"},
        "openshellNamespace": {"$ref": "#/definitions/nonempty"},
        "identityExchangeNamespace": {"$ref": "#/definitions/nonempty"},
        "litellmNamespace": {"$ref": "#/definitions/nonempty"},
        "ports": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kubernetesApi", "postgres", "jira", "litellm", "openshell", "identityExchange", "mcpGateway"],
          "properties": {
            "kubernetesApi": {"$ref": "#/definitions/port"},
            "postgres": {"$ref": "#/definitions/port"},
            "jira": {"$ref": "#/definitions/port"},
            "litellm": {"$ref": "#/definitions/port"},
            "openshell": {"$ref": "#/definitions/port"},
            "identityExchange": {"$ref": "#/definitions/port"},
            "mcpGateway": {"$ref": "#/definitions/port"}
          }
        }
      }
    },
    "spire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["csiDriver", "socketPath", "identityPath"],
      "properties": {
        "csiDriver": {"$ref": "#/definitions/nonempty"},
        "socketPath": {"type": "string", "pattern": "^/", "minLength": 2},
        "identityPath": {"type": "string", "pattern": "^/[a-z0-9/_-]+$", "minLength": 2}
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clusterDomain", "apiserverPort", "webhookPort", "mintPort", "webPort"],
      "properties": {
        "clusterDomain": {"$ref": "#/definitions/nonempty"},
        "apiserverPort": {"$ref": "#/definitions/port"},
        "webhookPort": {"$ref": "#/definitions/port"},
        "mintPort": {"$ref": "#/definitions/port"},
        "webPort": {"$ref": "#/definitions/port"}
      }
    },
    "replicaCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiserver", "controller", "mint", "web"],
      "properties": {
        "apiserver": {"type": "integer", "minimum": 1},
        "controller": {"type": "integer", "minimum": 1},
        "mint": {"type": "integer", "minimum": 1},
        "web": {"type": "integer", "minimum": 1}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiserver", "controller", "mint", "web"],
      "properties": {
        "apiserver": {"type": "object"},
        "controller": {"type": "object"},
        "mint": {"type": "object"},
        "web": {"type": "object"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "web": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]}
        }
      },
      "then": {
        "properties": {
          "images": {"properties": {"web": {"$ref": "#/definitions/image"}}},
          "browserAuth": {"properties": {"enabled": {"const": true}}},
          "networkPolicy": {"properties": {"enabled": {"const": true}}},
          "web": {}
        }
      }
    },
    {
      "if": {
        "properties": {
          "connectionsBridge": {
            "properties": {"enabled": {"const": true}},
            "required": ["enabled"]
          }
        }
      },
      "then": {
        "properties": {
          "browserAuth": {"properties": {"enabled": {"const": true}}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "web": {
            "properties": {
              "enabled": {"const": true},
              "ingress": {
                "properties": {"enabled": {"const": true}},
                "required": ["enabled"]
              }
            },
            "required": ["enabled", "ingress"]
          }
        }
      },
      "then": {
        "properties": {
          "web": {
            "properties": {
              "host": {"type": "string", "minLength": 3, "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$"},
              "ingress": {
                "properties": {
                  "className": {"$ref": "#/definitions/nonempty"},
                  "tlsSecretName": {"$ref": "#/definitions/nonempty"}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "browserAuth": {
            "properties": {"enabled": {"const": true}}
          },
          "networkPolicy": {
            "properties": {"enabled": {"const": true}}
          }
        }
      },
      "then": {
        "properties": {
          "networkPolicy": {
            "properties": {
              "browserAuthEgressCidrs": {"minItems": 1}
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "nonempty": {"type": "string", "minLength": 1},
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "cidrs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"},
      "uniqueItems": true
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "digest"],
      "properties": {
