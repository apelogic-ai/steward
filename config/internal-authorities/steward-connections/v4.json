{
  "schemaVersion": "steward/internal-authority/v1",
  "authorityId": "steward-connections",
  "authorityVersion": 4,
  "service": "steward-connections",
  "agentType": "connections-bridge",
  "llms": [],
  "tools": [
    {
      "provider": "github",
      "resource": "provider-control",
      "action": "status"
    },
    {
      "provider": "github",
      "resource": "provider-control",
      "action": "start"
    },
    {
      "provider": "github",
      "resource": "provider-control",
      "action": "disconnect"
    },
    {
      "provider": "github",
      "resource": "actions_run_trigger",
      "action": "write"
    },
    {
      "provider": "github",
      "resource": "search_repositories",
      "action": "read"
    },
    {
      "provider": "github",
      "resource": "get_me",
      "action": "read"
    },
    {
      "provider": "github",
      "resource": "get_file_contents",
      "action": "read"
    },
    {
      "provider": "github",
      "resource": "actions_list",
      "action": "read"
    },
    {
      "provider": "github",
      "resource": "actions_get",
      "action": "read"
    },
    {
      "provider": "github",
      "resource": "get_job_logs",
      "action": "read"
    },
    {
      "provider": "github",
      "resource": "get_commit",
      "action": "read"
    },
    {
      "provider": "github",
      "resource": "list_pull_requests",
      "action": "read"
    },
    {
      "provider": "github",
      "resource": "create_branch",
      "action": "write"
    },
    {
      "provider": "github",
      "resource": "push_files",
      "action": "write"
    },
    {
      "provider": "github",
      "resource": "create_pull_request",
      "action": "write"
    }
  ],
  "budget": {
    "monthlyLimit": "0.00",
    "singleRunLimit": "0.00",
    "currency": "USD"
  },
  "ttl": "2m",
  "runner": {
    "platforms": [
      "linux"
    ],
    "memory": "128Mi",
    "compute": "100m",
    "storage": "64Mi"
  },
  "execution": {
    "binary": "/usr/local/bin/steward-connections-bridge",
    "input": "request.json",
    "output": "response.json",
    "responseDeadlineSeconds": 40
  },
  "oauthContract": {
    "mcpGwVersion": "0.4.9",
    "stateLifetimeSeconds": 600,
    "clockSkewSeconds": 30
  }
}
