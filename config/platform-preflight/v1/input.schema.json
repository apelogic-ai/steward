{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steward.example.com/schemas/platform-input-v1.json",
  "title": "Steward platform preflight input",
  "type": "object",
  "required": [
    "schemaVersion",
    "namespaces",
    "deploymentLock",
    "database",
    "gateway",
    "publicEndpoints",
    "providerProfiles",
    "arc",
    "externalSecrets",
    "externalConfigMaps",
    "execution",
    "browserAuth",
    "apiTlsSecretName",
    "webhookTlsSecretName",
    "capabilityCatalog",
    "networkPolicy"
  ],
  "properties": {
    "schemaVersion": {"const": "steward.platform-input/v1"},
    "namespaces": {
      "type": "object",
      "required": ["steward", "runtime", "providers", "gateway", "arc", "databaseTls", "mcpGateway", "litellm", "identityExchange", "openshell", "dns"],
      "additionalProperties": false,
      "properties": {
        "steward": {"$ref": "#/$defs/name"},
        "runtime": {"$ref": "#/$defs/name"},
        "providers": {"$ref": "#/$defs/name"},
        "gateway": {"$ref": "#/$defs/name"},
        "arc": {"$ref": "#/$defs/name"},
        "databaseTls": {"$ref": "#/$defs/name"},
        "mcpGateway": {"$ref": "#/$defs/name"},
        "litellm": {"$ref": "#/$defs/name"},
        "identityExchange": {"$ref": "#/$defs/name"},
        "openshell": {"$ref": "#/$defs/name"},
        "dns": {"$ref": "#/$defs/name"}
      }
    },
    "deploymentLock": {
      "type": "object",
      "required": ["schemaVersion", "release", "mode", "requestedPlatform", "artifacts", "chartValues", "executionBindingImages"],
      "properties": {
        "schemaVersion": {"const": "steward.deployment-lock/v1"},
        "release": {"type": "object"},
        "mode": {"enum": ["index", "single-platform"]},
        "requestedPlatform": {"type": ["string", "null"]},
        "artifacts": {"type": "object"},
        "chartValues": {"type": "object"},
        "executionBindingImages": {"type": "object"}
      },
      "additionalProperties": false
    },
    "database": {"type": "object"},
    "gateway": {"type": "object"},
    "publicEndpoints": {"type": "array", "minItems": 1},
    "providerProfiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "namespace", "inputs"],
        "additionalProperties": false,
        "properties": {
          "name": {"$ref": "#/$defs/name"},
          "namespace": {"$ref": "#/$defs/name"},
          "inputs": {
            "type": "object",
            "required": ["gatewayOrigin", "runtimeGrantOrigin", "serviceCidrs"],
            "additionalProperties": false,
            "properties": {
              "gatewayOrigin": {"type": "string", "pattern": "^https://"},
              "runtimeGrantOrigin": {"type": "string", "pattern": "^https://"},
              "serviceCidrs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "arc": {"type": "object"},
    "externalSecrets": {"type": "object"},
    "externalConfigMaps": {"type": "object"},
    "execution": {"type": "object"},
    "browserAuth": {"type": "object"},
    "capabilityCatalog": {
      "type": "object",
      "required": ["schemaVersion", "models", "tools"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {"const": "steward.capability-catalog/v1"},
        "models": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/capabilityModel"}},
        "tools": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/capabilityTool"}}
      },
      "anyOf": [
        {"properties": {"models": {"minItems": 1}}},
        {"properties": {"tools": {"minItems": 1}}}
      ]
    },
    "networkPolicy": {
      "type": "object",
      "required": ["kubeApiCidrs", "postgresCidrs"],
      "additionalProperties": false,
      "properties": {
        "kubeApiCidrs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "postgresCidrs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "apiTlsSecretName": {"$ref": "#/$defs/name"},
    "webhookTlsSecretName": {"$ref": "#/$defs/name"}
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "capabilityModel": {
      "type": "object",
      "required": ["provider", "model"],
      "additionalProperties": false,
      "properties": {
        "provider": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "\\S"},
        "model": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "\\S"}
      }
    },
    "capabilityTool": {
      "type": "object",
      "required": ["provider", "resource", "action"],
      "additionalProperties": false,
      "properties": {
        "provider": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "\\S"},
        "resource": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "\\S"},
        "action": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "\\S"}
      }
    },
    "image": {
      "type": "object",
      "required": ["tag", "digest"],
      "additionalProperties": false,
      "properties": {
        "tag": {"type": "string", "minLength": 1, "not": {"const": "latest"}},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  },
  "additionalProperties": false
}
