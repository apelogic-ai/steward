{
  "schema": "steward.provider-profile-template/v1",
  "id": "steward-litellm",
  "metadata": {
    "displayName": "Steward inference gateway",
    "description": "Runtime-scoped inference gateway access",
    "category": "inference"
  },
  "capabilities": ["inference.completions"],
  "network": {
    "endpointInput": "gateway-origin",
    "allowedCidrsInput": "service-cidrs",
    "protocol": "https"
  },
  "authorization": {
    "authName": "api_key",
    "authDescription": "Runtime-bound inference access",
    "tokenGrantOriginInput": "runtime-grant-origin",
    "tokenPath": "/token",
    "audience": "steward-inference",
    "jwtSvidAudience": "steward-mint",
    "scopes": ["inference"],
    "cacheTtlSeconds": 2
  },
  "runtime": {
    "requiredBinaries": ["/usr/bin/curl", "/usr/local/bin/curl"]
  }
}
